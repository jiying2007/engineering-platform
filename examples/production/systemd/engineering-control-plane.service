[Unit]
Description=Engineering Platform Control Plane
Wants=network-online.target engineering-publisher.service
After=network-online.target engineering-publisher.service

[Service]
Type=simple
User=engineering-control
Group=engineering-platform
EnvironmentFile=/etc/engineering-platform/control.env
ExecStart=/opt/engineering-platform/bin/control-plane
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=20s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
