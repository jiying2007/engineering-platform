[Unit]
Description=Engineering Platform Control Plane
Wants=network-online.target engineering-publisher.service
After=network-online.target engineering-publisher.service

# Bound service crashes; this never authorizes replaying an engineering Run.
StartLimitIntervalSec=60s
StartLimitBurst=3

[Service]
Type=notify
NotifyAccess=main
User=engineering-control
Group=engineering-platform
EnvironmentFile=/etc/engineering-platform/control.env
ExecStart=/opt/engineering-platform/bin/control-plane --production
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=20s
KillMode=control-group
KillSignal=SIGTERM
SendSIGKILL=yes
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
