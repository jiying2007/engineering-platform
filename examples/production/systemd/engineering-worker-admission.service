[Unit]
Description=Engineering Platform Worker Admission
Wants=network-online.target
After=network-online.target engineering-control-plane.service
Requires=engineering-control-plane.service

# Bound service crashes; this never authorizes replaying an engineering Run.
StartLimitIntervalSec=60s
StartLimitBurst=3

[Service]
Type=simple
User=engineering-admission
Group=engineering-platform
EnvironmentFile=/etc/engineering-platform/worker-admission.env
ExecStart=/opt/engineering-platform/bin/worker --profile=worker/codex-production --admission-only
Restart=on-failure
RestartSec=5s
TimeoutStartSec=20s
TimeoutStopSec=20s
KillMode=control-group
KillSignal=SIGTERM
SendSIGKILL=yes
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
