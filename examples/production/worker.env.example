# Install as worker-admission.env / worker-preparation.env with mode 0600.
CONTROL_ENDPOINT=https://127.0.0.1:18443
CONTROL_CLIENT_CERT_FILE=/etc/engineering-platform/tls/REPLACE.crt
CONTROL_CLIENT_KEY_FILE=/etc/engineering-platform/tls/REPLACE.key
CONTROL_SERVER_CA_FILE=/etc/engineering-platform/tls/ca.crt
