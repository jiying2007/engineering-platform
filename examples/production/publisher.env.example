# Install as /etc/engineering-platform/publisher.env with mode 0600.
LISTEN_HOST=127.0.0.1
PORT=18444
PUBLISHER_CONFIG_FILE=/etc/engineering-platform/publisher-service.json
PUBLISHER_TLS_CERT_FILE=/etc/engineering-platform/tls/publisher.crt
PUBLISHER_TLS_KEY_FILE=/etc/engineering-platform/tls/publisher.key
PUBLISHER_CLIENT_CA_FILE=/etc/engineering-platform/tls/ca.crt
PUBLISHER_CONTROL_SUBJECT=urn:engineering-platform:control:publisher-client
