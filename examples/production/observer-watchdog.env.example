# Select these values outside the journal before each monitor invocation.
# Use the same newly generated session with production-status --session.
# This file contains no Control API credential and does not start the producer.
OBSERVER_JOURNAL=/var/lib/engineering-platform/observer/SELECTED_SESSION.jsonl
OBSERVER_SESSION=REPLACE_WITH_FRESH_32_LOWERCASE_HEX
CONTROL_ENDPOINT_DIGEST=sha256:REPLACE_WITH_CONFIGURED_ENDPOINT_SHA256
