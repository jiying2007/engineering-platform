# Install as /etc/engineering-platform/control.env with mode 0600.
# Supply the real DATABASE_URL out of band. Do not commit secrets.
LISTEN_HOST=127.0.0.1
PORT=18443
DATABASE_URL=postgres://REPLACE_OUT_OF_BAND
AUTO_MIGRATE=0
CONTROL_TLS_CERT_FILE=/etc/engineering-platform/tls/control.crt
CONTROL_TLS_KEY_FILE=/etc/engineering-platform/tls/control.key
CONTROL_CLIENT_CA_FILE=/etc/engineering-platform/tls/ca.crt
CONTROL_AUTH_POLICY_FILE=/etc/engineering-platform/access-policy.json
GITHUB_PUBLISHER_PLAN_FILE=/etc/engineering-platform/publisher-plan.json
GITHUB_PUBLISHER_REMOTE_FILE=/etc/engineering-platform/publisher-remote.json
